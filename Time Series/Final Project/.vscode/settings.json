{
    // Python / notebook: use the project's virtual environment
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],

    // LaTeX Workshop: report/main.tex uses pdflatex -> bibtex -> pdflatex x2;
    // slides/slides.tex picks the bibtex-free recipe with its `% !TEX recipe` line
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex + bibtex",
            "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
        },
        {
            "name": "pdflatex x2 (slides)",
            "tools": ["pdflatex", "pdflatex"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": ["%DOCFILE%"]
        }
    ],
    "latex-workshop.latex.recipe.default": "pdflatex + bibtex",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.autoClean.run": "never",

    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "report/*.aux": true,
        "report/*.bbl": true,
        "report/*.blg": true,
        "report/*.out": true,
        "report/*.fls": true,
        "report/*.fdb_latexmk": true,
        "report/*.synctex.gz": true,
        "report/*.xsim": true,
        "slides/*.aux": true,
        "slides/*.log": true,
        "slides/*.nav": true,
        "slides/*.out": true,
        "slides/*.snm": true,
        "slides/*.toc": true,
        "slides/*.synctex.gz": true
    }
}
